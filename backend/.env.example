PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/notes-dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Set to 1 only when running behind one trusted hosting proxy.
TRUST_PROXY=0
# HTTPS email delivery; set a verified sender before deployment.
RESEND_API_KEY=
EMAIL_FROM=
# SMTP fallback for local development.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Required for persistent profile image uploads in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
